{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "shared",
    "server",
    "tests"
  ],
  "exclude": [
    "server/plugins",
    "server/routes",
    "examples"
  ]
}
